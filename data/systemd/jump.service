[Unit]
Description=Jump launcher daemon
Documentation=https://github.com/Magnetar-OS/jump
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# --daemon starts without mapping the overlay, so autostart does not flash the
# launcher in the user's face at login.
ExecStart=%h/.local/bin/jump --daemon
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=graphical-session.target
